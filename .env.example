# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_ambulance?schema=public

# Server / Auth
PORT=5000
NODE_ENV=development
JWT_SECRET=super_secret_smart_ambulance_jwt_key_2026_dev!
FRONTEND_URL=http://localhost:3000
SOCKET_URL=http://localhost:5000

# Map & Routing Providers
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Traffic Provider (options: 'simulation', 'none', 'live')
TRAFFIC_PROVIDER=simulation
TRAFFIC_API_KEY=

# News Provider (options: 'builtin_rss', 'newsapi', 'none')
NEWS_PROVIDER=builtin_rss
NEWS_API_KEY=

# Weather Provider (options: 'open_meteo', 'none')
WEATHER_PROVIDER=open_meteo

# Expo Mobile Client
EXPO_PUBLIC_API_URL=http://localhost:5000/api
EXPO_PUBLIC_SOCKET_URL=http://localhost:5000

# Demo Center Coordinates (Configurable default)
DEMO_CITY=Metro Central
DEMO_LAT=28.6139
DEMO_LNG=77.2090
