generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  AMBULANCE_DRIVER
  NORMAL_USER
  HOSPITAL_OPERATOR
}

enum AmbulanceStatus {
  AVAILABLE
  ASSIGNED
  EN_ROUTE_TO_PATIENT
  AT_PATIENT
  PATIENT_ONBOARD
  EN_ROUTE_TO_HOSPITAL
  AT_HOSPITAL
  OFFLINE
  MAINTENANCE
}

enum EmergencyStatus {
  CREATED
  ASSIGNED
  EN_ROUTE_TO_PATIENT
  AT_PATIENT
  PATIENT_PICKED_UP
  EN_ROUTE_TO_HOSPITAL
  AT_HOSPITAL
  COMPLETED
  CANCELLED
}

enum EmergencyPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  ACTIVE
  UPDATED
  PASSED
  EXPIRED
  DISMISSED
}

enum AlertPriorityLevel {
  EMERGENCY_VEHICLE_NEARBY
  AMBULANCE_VERY_CLOSE
  AMBULANCE_APPROACHING
  AMBULANCE_NEARBY
}

model User {
  id           String      @id @default(uuid())
  name         String
  email        String      @unique
  passwordHash String
  role         UserRole    @default(NORMAL_USER)
  phone        String?
  hospitalId   String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  hospital         Hospital?         @relation(fields: [hospitalId], references: [id])
  ambulances       Ambulance[]       @relation("DriverAmbulances")
  emergencies      Emergency[]       @relation("DriverEmergencies")
  userLocation     UserLocation?
  emergencyAlerts  EmergencyAlert[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  refreshTokens    RefreshToken[]
  trips            Trip[]            @relation("DriverTrips")

  @@index([role])
  @@index([email])
}

model Ambulance {
  id                 String          @id @default(uuid())
  registrationNumber String          @unique
  driverId           String?
  status             AmbulanceStatus @default(AVAILABLE)
  latitude           Float?
  longitude          Float?
  speed              Float?
  heading            Float?
  accuracy           Float?
  lastLocationUpdate DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  driver             User?               @relation("DriverAmbulances", fields: [driverId], references: [id])
  emergencies        Emergency[]
  locations          AmbulanceLocation[]
  trips              Trip[]

  @@index([status])
  @@index([driverId])
}

model Hospital {
  id                     String      @id @default(uuid())
  name                   String
  address                String
  latitude               Float
  longitude              Float
  phone                  String?
  emergencyDepartmentOpen Boolean     @default(true)
  icuAvailable           Boolean     @default(true)
  icuBeds                Int         @default(10)
  totalAvailableBeds     Int         @default(50)
  receivingCapacity      Int         @default(100) // percentage 0-100
  status                 String      @default("ACTIVE")
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  staff                  User[]
  emergencies            Emergency[]

  @@index([latitude, longitude])
}

model Emergency {
  id               String            @id @default(uuid())
  emergencyNumber  String            @unique
  ambulanceId      String?
  driverId         String?
  pickupLatitude   Float
  pickupLongitude  Float
  pickupAddress    String
  hospitalId       String?
  priority         EmergencyPriority @default(HIGH)
  status           EmergencyStatus   @default(CREATED)
  routeId          String?
  startedAt        DateTime?
  patientArrivalAt DateTime?
  patientPickupAt  DateTime?
  hospitalArrivalAt DateTime?
  completedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  ambulance        Ambulance?          @relation(fields: [ambulanceId], references: [id])
  driver           User?               @relation("DriverEmergencies", fields: [driverId], references: [id])
  hospital         Hospital?           @relation(fields: [hospitalId], references: [id])
  routes           EmergencyRoute[]
  locations        AmbulanceLocation[]
  alerts           EmergencyAlert[]
  trip             Trip?

  @@index([status])
  @@index([ambulanceId])
  @@index([hospitalId])
}

model EmergencyRoute {
  id              String    @id @default(uuid())
  emergencyId     String
  originLat       Float
  originLng       Float
  destLat         Float
  destLng         Float
  distance        Float     // in meters
  duration        Float     // in seconds
  polylineJson    String    // JSON string of [lat, lng][]
  stepsJson       String?   // JSON string of RouteStep[]
  isEmergencyMode Boolean   @default(true)
  provider        String    @default("OSRM")
  trafficStatus   String?   @default("Live traffic unavailable")
  createdAt       DateTime  @default(now())

  emergency       Emergency @relation(fields: [emergencyId], references: [id], onDelete: Cascade)

  @@index([emergencyId])
}

model AmbulanceLocation {
  id          String     @id @default(uuid())
  ambulanceId String
  emergencyId String?
  latitude    Float
  longitude   Float
  speed       Float?
  heading     Float?
  accuracy    Float?
  recordedAt  DateTime   @default(now())

  ambulance   Ambulance  @relation(fields: [ambulanceId], references: [id], onDelete: Cascade)
  emergency   Emergency? @relation(fields: [emergencyId], references: [id], onDelete: SetNull)

  @@index([ambulanceId, recordedAt])
  @@index([emergencyId])
}

model UserLocation {
  id         String   @id @default(uuid())
  userId     String   @unique
  latitude   Float
  longitude  Float
  heading    Float?
  speed      Float?
  accuracy   Float?
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([latitude, longitude])
}

model EmergencyAlert {
  id              String             @id @default(uuid())
  emergencyId     String
  userId          String
  status          AlertStatus        @default(ACTIVE)
  priorityLevel   AlertPriorityLevel @default(AMBULANCE_APPROACHING)
  lastDistance    Float              // in meters
  lastEtaSeconds  Int                // in seconds
  safeInstruction String             @default("Please give way and allow the ambulance to pass when safe and legal to do so.")
  sentAt          DateTime           @default(now())
  lastUpdatedAt   DateTime           @default(now())
  expiredAt       DateTime?

  emergency       Emergency          @relation(fields: [emergencyId], references: [id], onDelete: Cascade)
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([emergencyId, userId])
  @@index([status])
  @@index([userId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("INFO")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model Trip {
  id                  String     @id @default(uuid())
  emergencyId         String     @unique
  ambulanceId         String
  driverId            String?
  distanceMeters      Float      @default(0)
  durationSeconds     Float      @default(0)
  alertCount          Int        @default(0)
  responseTimeSeconds Float?
  startedAt           DateTime
  completedAt         DateTime?

  emergency           Emergency  @relation(fields: [emergencyId], references: [id], onDelete: Cascade)
  ambulance           Ambulance  @relation(fields: [ambulanceId], references: [id])
  driver              User?      @relation("DriverTrips", fields: [driverId], references: [id])

  @@index([ambulanceId])
  @@index([startedAt])
}

model NewsArticle {
  id          String   @id @default(uuid())
  title       String
  summary     String
  source      String
  url         String?
  imageUrl    String?
  category    String   @default("Local")
  publishedAt DateTime @default(now())
  cachedAt    DateTime @default(now())

  @@index([category, publishedAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}
